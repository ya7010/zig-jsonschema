{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "title": "Customer",
  "properties": {
    "address": {
      "$ref": "#/$defs/Address"
    },
    "previous": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Address"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "minProperties": 1,
      "additionalProperties": true
    },
    "billing": {
      "anyOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "address",
    "previous",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "Address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "zip": {
          "type": "string",
          "pattern": "^[0-9]{3}-[0-9]{4}$"
        }
      },
      "required": [
        "street",
        "zip"
      ]
    }
  }
}
