{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "Customer",
  "properties": {
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "zip": {
          "type": "string",
          "pattern": "^[0-9]{3}-[0-9]{4}$"
        }
      },
      "required": [
        "street",
        "zip"
      ]
    },
    "previous": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "minLength": 1
          },
          "zip": {
            "type": "string",
            "pattern": "^[0-9]{3}-[0-9]{4}$"
          }
        },
        "required": [
          "street",
          "zip"
        ]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "minProperties": 1,
      "additionalProperties": true
    },
    "billing": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "zip": {
          "type": "string",
          "pattern": "^[0-9]{3}-[0-9]{4}$"
        }
      },
      "required": [
        "street",
        "zip"
      ]
    }
  },
  "required": [
    "address",
    "previous",
    "metadata"
  ],
  "additionalProperties": false
}
