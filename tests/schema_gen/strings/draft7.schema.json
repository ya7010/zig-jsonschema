{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "pattern": "^[A-Z]{3}$"
    },
    "note": {
      "type": "string",
      "description": "Free text",
      "default": ""
    },
    "label": {
      "type": "string"
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "code",
    "label"
  ]
}
