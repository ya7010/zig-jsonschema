{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "address": {
      "$ref": "#/definitions/Address"
    }
  },
  "required": [
    "name",
    "address"
  ],
  "additionalProperties": true,
  "definitions": {
    "Address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "zip": {
          "type": "string",
          "pattern": "^[0-9]{3}-[0-9]{4}$"
        }
      },
      "required": [
        "street",
        "zip"
      ],
      "additionalProperties": false
    }
  }
}
