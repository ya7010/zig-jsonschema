{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "properties": {
    "tagged": {
      "$ref": "#/$defs/TaggedShape"
    },
    "inline_tagged": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "on",
            "off"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "on"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "type": {
                "const": "on"
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "required": [
              "type",
              "level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "off"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "type": {
                "const": "off"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      ]
    },
    "shape": {
      "$ref": "#/$defs/Shape"
    },
    "id": {
      "$ref": "#/$defs/Id"
    }
  },
  "required": [
    "tagged",
    "inline_tagged",
    "shape",
    "id"
  ],
  "$defs": {
    "TaggedShape": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "circle",
            "rect",
            "empty"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "circle"
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "kind",
              "radius"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rect"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "rect"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "width",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "empty"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "empty"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      ]
    },
    "Shape": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "enum": [
          "circle",
          "rect",
          "label",
          "empty"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "circle"
            ]
          },
          "then": {
            "properties": {
              "circle": {
                "$ref": "#/$defs/Circle"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "rect"
            ]
          },
          "then": {
            "properties": {
              "rect": {
                "$ref": "#/$defs/Rect"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "empty"
            ]
          },
          "then": {
            "properties": {
              "empty": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "Circle": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "radius"
      ]
    },
    "Rect": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "Id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
