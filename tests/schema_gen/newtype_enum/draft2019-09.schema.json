{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "owner": {
      "type": "integer",
      "description": "Owner account",
      "minimum": 1
    },
    "members": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "parent": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "owner",
    "members"
  ]
}
